# Copy to .env and fill in. Never commit the real .env.

# mock | ollama | gemini
VIGIL_PROVIDER=mock

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Ollama (ollama pull qwen2.5vl:7b && ollama serve)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# pipeline
VIGIL_TAU=0.92
VIGIL_FPS=2.0
VIGIL_LOG_DIR=logs
VIGIL_REPLAY_SPEED=1.0
VIGIL_LOG_LEVEL=INFO

# YouTube resolution on cloud hosts / datacenter IPs (Render, AWS, GCP)
# Raw Netscape formatted cookies, base64 string, or path to cookies.txt
YOUTUBE_COOKIES=
YOUTUBE_PLAYER_CLIENTS=android,ios,mweb,web
